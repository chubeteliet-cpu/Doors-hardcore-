--============================================================
-- DEER GOD - FULL
-- Không ColorCorrection
-- Không Rebound
-- Tự biến mất sau 30 giây
--============================================================

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

if not RunService:IsServer() then
	warn("Chạy trên client? Script này nên chạy server-side.")
end

--============================================================
-- LOAD ENTITY SPAWNER
--============================================================

local okSpawner, spawner = pcall(function()

	return loadstring(game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"
	))()

end)

if not okSpawner or not spawner then
	warn(
		"[DEER GOD] Không load được Entity Spawner:",
		spawner
	)
	return
end

--============================================================
-- GITHUB MP3
--============================================================

local SOUND_URL =
	"https://raw.githubusercontent.com/chubeteliet-cpu/Doors-hardcore-/refs/heads/main/Deer%20god%20.mp3"

local function getGitSoundId(url, name)

	local ok, res = pcall(function()

		local fileName =
			name .. ".mp3"

		if not isfile(fileName) then

			local data =
				game:HttpGet(url)

			if not data or #data == 0 then
				error("MP3 tải về rỗng.")
			end

			writefile(
				fileName,
				data
			)
		end

		return getcustomasset(fileName)

	end)

	if ok and res then
		return res
	end

	warn(
		"[DEER GOD] Không tải được MP3:",
		tostring(res)
	)

	return nil
end

--============================================================
-- PLAY SOUND
--============================================================

local sound =
	Instance.new("Sound")

sound.Name =
	"DeerGodMusic"

local loadedId =
	getGitSoundId(
		SOUND_URL,
		"deer_god_music"
	)

if loadedId then

	sound.SoundId =
		loadedId

end

sound.Volume =
	4

sound.Looped =
	false

sound.PlaybackSpeed =
	1

sound.Parent =
	Workspace

if sound.SoundId ~= "" then

	pcall(function()
		sound:Play()
	end)

	sound.Ended:Connect(function()

		if sound.Parent then
			sound:Destroy()
		end

	end)

end

--============================================================
-- RANDOM
--============================================================

math.randomseed(
	math.floor(
		os.clock() * 1000000
	)
)

local randSpeed =
	math.random(50, 90)

local randDelay =
	math.random(1, 3)

local randHeight =
	math.random(-2, 2)

