					"deer god"
			}
		})

	end)

if not okCreate or not result then

	warn(
		"[DEER GOD] Không tạo được entity:",
		result
	)

	return
end

local entity =
	result

--============================================================
-- DAMAGE CALLBACK
--============================================================

pcall(function()

	entity:SetCallback(
		"OnDamagePlayer",
		function(player)

			if typeof(player)
				~= "Instance" then
				return
			end

			if not player:IsA("Player") then
				return
			end

			pcall(function()

				local gameStats =
					ReplicatedStorage:
					FindFirstChild(
						"GameStats"
					)

				if not gameStats then
					return
				end

				local stats =
					gameStats:
					FindFirstChild(
						"Player_"
						.. player.Name
					)

				if not stats then
					return
				end

				local total =
					stats:
					FindFirstChild(
						"Total"
					)

				if not total then
					return
				end

				local deathCause =
					total:
					FindFirstChild(
						"DeathCause"
					)

				if deathCause then
					deathCause.Value =
						"deer god"
				end

			end)

		end
	)

end)

--============================================================
-- RUN ENTITY
--============================================================

local okRun, runError =
	pcall(function()

		entity:Run()

	end)

if not okRun then

	warn(
		"[DEER GOD] entity:Run() lỗi:",
		runError
	)

	return
end

print(
	"[DEER GOD] Entity đã spawn."
)

--============================================================
-- FIND ENTITY
--============================================================

local function FindDeerGod()

	for i = 1, 100 do

		local model =
			Workspace:
			FindFirstChild(
				"deer god",
				true
			)

		if model then
			return model
		end

		task.wait(0.1)

	end

	return nil
end

local deerModel =
	FindDeerGod()

--============================================================
-- REMOVE AFTER 30 SECONDS
--============================================================

task.delay(
	30,
	function()

		print(
			"[DEER GOD] 30 giây -> xóa entity."
		)

		-- Xóa model đã tìm
		if deerModel
			and deerModel.Parent then

			pcall(function()
				deerModel:Destroy()
			end)

		end

		-- Backup scan
		for _, obj in ipairs(
			Workspace:GetDescendants()
		) do

			if obj:IsA("Model") then

				local name =
					string.lower(
						obj.Name
					)

				if name == "deer god"
					or name:find(
						"deer god",
						1,
						true
					) then

					pcall(function()
						obj:Destroy()
					end)

				end
			end
		end

		print(
			"[DEER GOD] Entity removed."
		)

	end
)

print("==================================================")
print(" DEER GOD LOADED")
