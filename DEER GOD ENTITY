					randHeight
			},

			Lights = {

				Flicker = {

					Enabled =
						true,

					Duration =
						14
				},

				Shatter =
					true,

				Repair =
					false
			},

			CameraShake = {

				Enabled =
					false,

				Range =
					0,

				Values = {
					0,
					0,
					0,
					0
				}
			},

			Movement = {

				Speed =
					25,

				Delay =
					randDelay,

				Reversed =
