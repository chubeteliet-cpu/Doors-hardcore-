--============================================================
-- CEASY
-- Entity phải xuất hiện trước
--
-- Entity xa Player:
--   Player di chuyển bình thường
--
-- Entity <= 50 studs:
--   Player đứng im = sống
--   Player di chuyển = chết 100%
--============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--============================================================
-- LOAD SPAWNER
--============================================================

local spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"
))()

if not spawner then
	warn("[CEASY] Không load được Entity Spawner.")
	return
end

--============================================================
-- LIGHTING
--============================================================

local function ensureMainColorCorrection()

	local cc =
		Lighting:FindFirstChild("MainColorCorrection")

	if not cc then

		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "MainColorCorrection"
		cc.Parent = Lighting

	end

	return cc
end

local cc = ensureMainColorCorrection()

cc.TintColor = Color3.fromRGB(0, 0, 255)
cc.Contrast = 1

pcall(function()

	TweenService:Create(
		cc,
		TweenInfo.new(2.5),
		{
			Contrast = 0
		}
	):Play()

	TweenService:Create(
		cc,
		TweenInfo.new(80),
		{
			TintColor = Color3.fromRGB(255, 255, 255)
		}
	):Play()

end)

--============================================================
-- RANDOM
--============================================================

math.randomseed(
	math.floor(os.clock() * 1000000)
)

local randDelay = math.random(1, 3)
local randHeight = math.random(-2, 2)

--============================================================
-- CREATE ENTITY
--============================================================

local entity = spawner.Create({

	Entity = {

		Name = "ceasy",

		Asset = "rbxassetid://12262854624",

		HeightOffset = randHeight
	},

	Lights = {

		Flicker = {
			Enabled = false,
			Duration = 5
		},

		Shatter = false,

		Repair = false
	},

	CameraShake = {

		Enabled = true,

		Range = 100,

		Values = {
			2,
			25,
			0.1,
			1
		}
	},

	Movement = {

		Speed = 69,

		Delay = randDelay,

		Reversed = false
	},

	Rebounding = {

		Enabled = false,

		Type = "Ambush",

		Min = 2,

		Max = 5,

		Delay = 2
	},

	-- Quan trọng:
	-- Damage gốc tắt để entity không tự giết.
	Damage = {

		Enabled = false,

		Range = 0,

		Amount = 0
	},

	Crucifixion = {

		Enabled = true,

		Range = 40,

		Resist = true,

		Break = true
	},

	Death = {

		Type = "Guiding",

		Hints = {
			""
		},

		Cause = "ceasy"
	}
})

if not entity then
	warn("[CEASY] spawner.Create() thất bại.")
	return
end

--============================================================
-- CALLBACK
--============================================================

entity:SetCallback(
	"OnDamagePlayer",
	function(player, newHealth)

		if typeof(player) ~= "Instance"
			or not player:IsA("Player") then
			return
		end

		pcall(function()

			local gameStats =
				ReplicatedStorage:FindFirstChild("GameStats")

			if not gameStats then
				return
			end

			local stats =
				gameStats:FindFirstChild(
					"Player_" .. player.Name
				)

			if not stats then
				return
			end

			local total =
				stats:FindFirstChild("Total")

			if not total then
				return
			end

			local deathCause =
				total:FindFirstChild("DeathCause")

			if deathCause then
				deathCause.Value = "ceasy"
			end

		end)

	end
)

--============================================================
-- CHẠY ENTITY TRƯỚC
--============================================================

print("[CEASY] Starting entity...")

local runSuccess, runError = pcall(function()
	entity:Run()
end)

if not runSuccess then
	warn("[CEASY] entity:Run() lỗi:", runError)
	return
end

print("[CEASY] entity:Run() OK")

--============================================================
-- TÌM MODEL SAU KHI RUN
--============================================================

local function FindCeasy()

	-- Chờ tối đa 10 giây
	for i = 1, 100 do

		-- Tìm theo tên
		local named =
			workspace:FindFirstChild(
				"ceasy",
				true
			)

		if named then
			return named
		end

		-- Chờ entity tạo xong
		task.wait(0.1)

