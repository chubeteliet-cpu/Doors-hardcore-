local ceasy = FindCeasy()

if not ceasy then

	warn(
		"[CEASY] Entity đã Run nhưng không tìm thấy model ceasy."
	)

	return
end

print(
	"[CEASY] Found:",
	ceasy:GetFullName()
)

--============================================================
-- ENTITY ROOT
--============================================================

local function GetEntityRoot(model)

	if not model then
		return nil
	end

	if model:IsA("Model") then

		return model.PrimaryPart
			or model:FindFirstChild(
				"HumanoidRootPart",
				true
			)
			or model:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	elseif model:IsA("BasePart") then

		return model
	end

	return nil
end

local function GetPlayerRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--============================================================
-- KILL
--============================================================

local function KillPlayer(player)

	local character =
		player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	-- DeathCause
	pcall(function()

		local gameStats =
			ReplicatedStorage:FindFirstChild(
				"GameStats"
			)

		if gameStats then

			local stats =
				gameStats:FindFirstChild(
					"Player_" .. player.Name
				)

			if stats then

				local total =
					stats:FindFirstChild("Total")

				if total then

					local deathCause =
						total:FindFirstChild(
							"DeathCause"
						)

					if deathCause then
						deathCause.Value = "ceasy"
					end

				end
			end
		end

	end)

	-- Chết 100%
	humanoid.Health = 0

end

--============================================================
-- PLAYER SYSTEM
--============================================================

local ACTIVATION_DISTANCE = 50
local MOVE_THRESHOLD = 0.05

local connections = {}

local function SetupPlayer(player)

	-- Xóa connection cũ
	if connections[player] then
		for _, connection in ipairs(
			connections[player]
		) do
			pcall(function()
				connection:Disconnect()
			end)
		end
	end

	connections[player] = {}

	local function SetupCharacter(character)

		local root =
			character:WaitForChild(
				"HumanoidRootPart",
				10
			)

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if not root or not humanoid then
			return
		end

		-- Vị trí trước khi entity lại gần
		local lastPosition =
			root.Position

		local activated = false
		local dead = false

		local connection

		connection =
			RunService.Heartbeat:Connect(
				function()

					if not player.Parent
						or not character.Parent
						or not ceasy
						or not ceasy.Parent then

						connection:Disconnect()
						return
					end

					if humanoid.Health <= 0 then

						connection:Disconnect()
						return
					end

					local entityRoot =
						GetEntityRoot(ceasy)

					if not entityRoot then
						return
					end

					--========================================
					-- DISTANCE
					--========================================

					local distance =
						(
							entityRoot.Position
							- root.Position
						).Magnitude

					--========================================
					-- ENTITY CHƯA GẦN
					--========================================

					if distance > ACTIVATION_DISTANCE then

						activated = false

						-- Cập nhật liên tục
						-- để Player được tự do di chuyển
						lastPosition =
							root.Position

						return
					end

					--========================================
					-- ENTITY ĐÃ GẦN
					--========================================

					if not activated then

						activated = true

						-- Lấy vị trí ngay tại thời điểm
						-- entity bước vào vùng nguy hiểm
						lastPosition =
							root.Position

						print(
							"[CEASY]",
							player.Name,
							"đã vào vùng nguy hiểm."
						)

						return
					end

					local currentPosition =
						root.Position

					local moved =
						(
							currentPosition
							- lastPosition
						).Magnitude
						> MOVE_THRESHOLD

					--========================================
					-- PLAYER DI CHUYỂN = CHẾT
					--========================================

					if moved and not dead then

						dead = true

						print(
							"[CEASY]",
							player.Name,
							"DI CHUYỂN -> DEAD"
						)

						KillPlayer(player)

						connection:Disconnect()

						return
					end

					lastPosition =
						currentPosition

				end
			)

		table.insert(
			connections[player],
			connection
		)
	end

	-- Character hiện tại
	if player.Character then
		task.spawn(function()
			SetupCharacter(player.Character)
		end)
	end

	-- Respawn
	local charConnection =
		player.CharacterAdded:Connect(
			function(character)

				task.wait(0.5)

				SetupCharacter(character)

			end
		)

	table.insert(
		connections[player],
		charConnection
	)
end

--============================================================
-- PLAYERS
--============================================================

for _, player in ipairs(
	Players:GetPlayers()
) do

	SetupPlayer(player)

end

Players.PlayerAdded:Connect(
	function(player)
		SetupPlayer(player)
	end
)

Players.PlayerRemoving:Connect(
	function(player)

		if connections[player] then

			for _, connection in ipairs(
				connections[player]
			) do

				pcall(function()
					connection:Disconnect()
				end)

			end
		end

		connections[player] = nil

	end
)

