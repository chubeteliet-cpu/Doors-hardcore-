--==================================================
-- CHARACTER + SPEED BOOST ICON
--==================================================
local function setupCharacter(character)
	humanoid = character:WaitForChild("Humanoid")

	local gui = player:WaitForChild("PlayerGui")

	local speedBoostIcon

	pcall(function()
		speedBoostIcon =
			gui.MainUI.MainFrame.Healthbar.Effects.SpeedBoost
	end)

	local function checkBoost()
		if not speedBoostIcon then
			return
		end

		if not sprintActive or humanoid.Health <= 0 then
			speedBoostIcon.Visible = false
			return
		end

		if humanoid.WalkSpeed == normalSpeed then
			humanoid.WalkSpeed = normalSpeed + speedBoostValue
			speedBoostIcon.Visible = true

		elseif humanoid.WalkSpeed == normalSpeed + speedBoostValue then
			speedBoostIcon.Visible = true

		else
			speedBoostIcon.Visible = false
		end
	end

	humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(checkBoost)
	humanoid:GetPropertyChangedSignal("Health"):Connect(checkBoost)

	humanoid.Died:Connect(function()
		sprintActive = false

		if speedBoostIcon then
			speedBoostIcon.Visible = false
		end

		if humanoid then
			humanoid.WalkSpeed = normalSpeed
		end

		barBackground.Visible = false
	end)

	humanoid.WalkSpeed = normalSpeed
	checkBoost()
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
end

--==================================================
-- SPRINT TOGGLE
--==================================================
local function toggleSprint()
	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	if sprintActive then

		-- TẮT CHẠY
		sprintActive = false
		humanoid.WalkSpeed = normalSpeed

	else

		-- BẬT CHẠY
		if stamina > 0 then
			sprintActive = true
			humanoid.WalkSpeed = normalSpeed + speedBoostValue
		end

	end
end

--==================================================
-- MOBILE BUTTON
--==================================================
sprintButton.MouseButton1Click:Connect(function()
	toggleSprint()
end)

--==================================================
-- PC SHIFT
--==================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.LeftShift then
		toggleSprint()
	end
end)

--==================================================
-- STAMINA + UI
--==================================================
RunService.RenderStepped:Connect(function(dt)

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	local isMoving =
		humanoid.MoveDirection.Magnitude > 0

	--================================================
	-- ĐANG CHẠY + DI CHUYỂN
	--================================================
	if sprintActive and isMoving then

		humanoid.WalkSpeed =
			normalSpeed + speedBoostValue

		stamina -= staminaDrain * dt

		if stamina <= 0 then
			stamina = 0
			sprintActive = false
			humanoid.WalkSpeed = normalSpeed
		end

	else

		--================================================
		-- HỒI STAMINA
		--================================================
		stamina += staminaRegen * dt

		if stamina > maxStamina then
			stamina = maxStamina
		end

	end

	--================================================
	-- UPDATE STAMINA BAR
	--================================================
	local percent = stamina / maxStamina

	barFill.Size =
		UDim2.new(percent, 0, 1, 0)

	staminaText.Text =
		math.floor(percent * 100) .. "%"

	--================================================
	-- ẨN / HIỆN STAMINA
	--================================================
	if sprintActive and stamina < maxStamina then
		barBackground.Visible = true
	else
		barBackground.Visible = false
	end

end)
