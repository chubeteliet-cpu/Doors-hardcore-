local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local entityName = "silence"
local entityAsset = "rbxassetid://16167850268"

local musicUrl = "https://raw.githubusercontent.com/binhxd30-eng/Light-break/main/Light%20broken.mp3"
local musicFile = "silence_music.mp3"

local waitTime = 2

if not game.HttpGet then
	warn("[SILENCE] HttpGet is not supported.")
	return
end

if not isfile or not writefile or not getcustomasset then
	warn("[SILENCE] isfile, writefile or getcustomasset is missing.")
	return
end

math.randomseed(math.floor(os.clock() * 1000000))

local height = math.random(-2, 2)
local reboundMin = math.random(2, 4)
local reboundMax = reboundMin + math.random(1, 3)

local function playMusic()
	if not isfile(musicFile) then
		local success, data = pcall(function()
			return game:HttpGet(musicUrl)
		end)

		if not success or not data or #data == 0 then
			warn("[SILENCE] Failed to download music.")
			return
		end

		local saved = pcall(function()
			writefile(musicFile, data)
		end)

		if not saved then
			warn("[SILENCE] Failed to save music.")
			return
		end
	end

	local old = SoundService:FindFirstChild("SilenceMusic")

	if old then
		old:Destroy()
	end

	local success, result = pcall(function()
		local sound = Instance.new("Sound")

		sound.Name = "SilenceMusic"
		sound.SoundId = getcustomasset(musicFile)
		sound.Volume = 5
		sound.Looped = false
		sound.Parent = SoundService

		sound:Play()

		sound.Ended:Connect(function()
			if sound then
				sound:Destroy()
			end
		end)

		return sound
	end)

	if not success then
		warn("[SILENCE] Music error:", result)
	end
end

playMusic()

local function getColorCorrection()
	local effect = Lighting:FindFirstChild("MainColorCorrection")

	if not effect then
		effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "MainColorCorrection"
		effect.Parent = Lighting
	end

	return effect
end

local colorCorrection = getColorCorrection()

colorCorrection.TintColor = Color3.fromRGB(0, 0, 255)
colorCorrection.Contrast = 1

pcall(function()
	TweenService:Create(
		colorCorrection,
		TweenInfo.new(2.5),
		{
			Contrast = 0
		}
	):Play()

	TweenService:Create(
		colorCorrection,
		TweenInfo.new(80),
		{
			TintColor = Color3.fromRGB(255, 255, 255)
		}
	):Play()
end)

local sourceSuccess, source = pcall(function()
	return game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"
	)
end)

if not sourceSuccess or not source then
	warn("[SILENCE] Failed to load Entity Spawner.")
	return
end

local loadSuccess, spawner = pcall(function()
	return loadstring(source)()
end)

if not loadSuccess or not spawner then
	warn("[SILENCE] Failed to initialize Entity Spawner.")
	return
end

local createSuccess, entity = pcall(function()
	return spawner.Create({
		Entity = {
			Name = entityName,
			Asset = entityAsset,
			HeightOffset = height
		},

		Lights = {
			Flicker = {
				Enabled = false,
				Duration = 5
			},

			Shatter = false,
			Repair = false
		},

		CameraShake = {
			Enabled = true,
			Range = 100,

			Values = {
				2,
				25,
				0.1,
				1
			}
		},

		Movement = {
			Speed = 50,
			Delay = 6,
			Reversed = false
		},

		Rebounding = {
			Enabled = false,
			Type = "Ambush",
			Min = reboundMin,
			Max = reboundMax,
			Delay = 2
		},

		Damage = {
			Enabled = true,
			Range = 50,
			Amount = 9999
		},

		Crucifixion = {
			Enabled = true,
			Range = 40,
			Resist = true,
			Break = true
		},

		Death = {
			Type = "Guiding",
			Hints = {
				""
			},
			Cause = entityName
		}
	})
end)

if not createSuccess or not entity then
	warn("[SILENCE] Failed to create entity:", entity)
	return
end

entity:SetCallback("OnDamagePlayer", function(targetPlayer)
	if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then
		return
	end

	pcall(function()
		local gameStats = ReplicatedStorage:FindFirstChild("GameStats")

		if not gameStats then
			return
		end

		local stats = gameStats:FindFirstChild("Player_" .. targetPlayer.Name)

		if not stats then
			return
		end

		local total = stats:FindFirstChild("Total")

		if not total then
			return
		end

		local deathCause = total:FindFirstChild("DeathCause")

		if deathCause then
			deathCause.Value = entityName
		end
	end)
end)

task.wait(waitTime)

local runSuccess, runError = pcall(function()
	entity:Run()
end)

if not runSuccess then
	warn("[SILENCE] Failed to run entity:", runError)
	return
end

print("[SILENCE] Music started.")
print("[SILENCE] Lights untouched.")
print("[SILENCE] Waiting:", waitTime, "seconds.")
print("[SILENCE] Entity spawned.")
