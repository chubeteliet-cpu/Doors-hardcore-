local function PlayMusicImmediately()

	local downloaded = false

	-- Tải MP3
	if not isfile(MUSIC_FILE) then

		local success, data = pcall(function()
			return game:HttpGet(MUSIC_URL)
		end)

		if success and data and #data > 0 then

			local writeSuccess = pcall(function()
				writefile(MUSIC_FILE, data)
			end)

			if writeSuccess then
				downloaded = true
			end

		end

	else

		downloaded = true

	end

	if not downloaded then
		warn("[SILENCE] Không tải được MP3.")
		return
	end

	local success, result = pcall(function()

		local oldSound =
			SoundService:FindFirstChild("SilenceMusic")

		if oldSound then
			oldSound:Destroy()
		end

		local sound = Instance.new("Sound")

		sound.Name = "SilenceMusic"

		sound.SoundId =
			getcustomasset(MUSIC_FILE)

		sound.Volume = 5

		sound.Looped = false

		sound.Parent =
			SoundService

		sound:Play()

		sound.Ended:Connect(function()

			pcall(function()
				sound:Destroy()
			end)

		end)

		return sound

	end)

	if not success then

		warn(
			"[SILENCE] Không phát được nhạc:",
			result
		)

	else

		print("[SILENCE] Music started.")

	end

end

-- PHÁT NGAY
PlayMusicImmediately()

