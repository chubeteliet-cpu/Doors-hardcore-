--============================================================
-- DAMAGE CALLBACK
--============================================================

entity:SetCallback(
	"OnDamagePlayer",
	function(player, newHealth)

		if typeof(player) ~= "Instance"
			or not player:IsA("Player") then
			return
		end

		pcall(function()

			local gameStats =
				ReplicatedStorage:FindFirstChild(
					"GameStats"
				)

			if not gameStats then
				return
			end

			local stats =
				gameStats:FindFirstChild(
					"Player_" ..
					player.Name
				)

			if not stats then
				return
			end

			local total =
				stats:FindFirstChild(
					"Total"
				)

			if not total then
				return
			end

			local deathCause =
				total:FindFirstChild(
					"DeathCause"
				)

			if deathCause then

				deathCause.Value =
					ENTITY_NAME

			end

		end)

	end
)

