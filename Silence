local function BreakLights()

	for _, obj in ipairs(
		workspace:GetDescendants()
	) do

		-- Tắt Light
		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			pcall(function()

				obj.Enabled = false

			end)

		end

		-- Làm bóng đèn biến mất
		if obj:IsA("BasePart") then

			local name =
				string.lower(
					obj.Name
				)

			if name:find(
				"light",
				1,
				true
			)
			or name:find(
				"bulb",
				1,
				true
			)
			or name:find(
				"lamp",
				1,
				true
			) then

				pcall(function()

					obj.Transparency = 1

					obj.CanCollide = false

					obj.CanTouch = false

					obj.CanQuery = false

				end)

			end

		end
	end

	print("[SILENCE] Lights broken.")

end

