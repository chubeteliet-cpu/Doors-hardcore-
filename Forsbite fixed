-- 🛡️ Các vật không được đóng băng/phá
local blacklist = {
	"key",
	"breaker",
	"gold",
	"floor",
	"wall",
	"ceiling",
	"entrance",
	"exit",
	"door"
}

local function IsProtected(part)

	local lowerName =
		part.Name:lower()

	for _, name in ipairs(blacklist) do

		if string.find(
			lowerName,
			name,
			1,
			true
		) then
			return true
		end
	end

	local model =
		part:FindFirstAncestorOfClass(
			"Model"
		)

	if model then

		if model:FindFirstChildOfClass(
			"Humanoid"
		) then
			return true
		end

		if string.find(
			model.Name:lower(),
			"door",
			1,
			true
		) then
			return true
		end
	end

	return false
end

-- 💾 Lưu trạng thái vật thể
local originalMetadata = {}
local brokenParts = {}

for _, part in ipairs(
	activeRoom:GetDescendants()
) do

	if part:IsA("BasePart")
		and not part:IsDescendantOf(s)
		and not IsProtected(part) then

		originalMetadata[part] = {
			Color = part.Color,
			Material = part.Material,
			Anchored = part.Anchored,
			CanCollide = part.CanCollide,
			CanQuery = part.CanQuery
		}
	end
end

