-- 🧊 Frost
local currentFrost = 0
local dmg = true

-- 🚪 Theo dõi room
local startingRoom =
	LatestRoom.Value

local roomChanged = false

local roomConnection

roomConnection =
	LatestRoom.Changed:Connect(
	function(newRoom)

		if newRoom ~= startingRoom then

			roomChanged = true
			dmg = false

		end
	end
)

-- 🧊 Hệ thống Cold
task.spawn(function()

	while dmg and not roomChanged do

		task.wait(0.1)

		local character =
			player.Character

		if not character then
			continue
		end

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if not humanoid
			or humanoid.Health <= 0 then

			dmg = false
			break
		end

		-- 🔥 Lighter
		local lighter =
			character:FindFirstChild(
				"Lighter"
			)

		local hasHeat =
			lighter
			and lighter:GetAttribute(
				"Enabled"
			) == true

		if hasHeat then

			currentFrost =
				math.max(
					0,
					currentFrost - 2.5
				)

		else

			currentFrost =
				math.min(
					100,
					currentFrost + 0.8
				)

		end

		local progress =
			currentFrost / 100

		-- 🌫️ Overlay
		imageLabel.ImageTransparency =
			1 - progress

		blur.Size =
			progress * 15

		blur.Enabled =
			progress > 0

		-- 🧊 Đóng băng môi trường
		for part, data in pairs(
			originalMetadata
		) do

			if part and part.Parent then

				local frostColor =
					Color3.fromRGB(
						115,
						200,
						255
					)

				part.Color =
					data.Color:Lerp(
						frostColor,
						progress
					)

				if currentFrost > 40 then

					part.Material =
						Enum.Material.Ice

					if currentFrost > 65
						and not brokenParts[part] then

						brokenParts[part] = true

						part.Anchored = false
						part:BreakJoints()
						part.Massless = true
						part.CanCollide = false
						part.CanQuery = false

						part.CustomPhysicalProperties =
							PhysicalProperties.new(
								0.01,
								0.3,
								0.5,
								1,
								1
							)

						part.AssemblyLinearVelocity =
							Vector3.new(
								math.random(-25, 25),
								math.random(10, 35),
								math.random(-25, 25)
							)

						part.AssemblyAngularVelocity =
							Vector3.new(
								math.random(-5, 5),
								math.random(-5, 5),
								math.random(-5, 5)
							)
					end

				elseif not brokenParts[part] then

					part.Material =
						data.Material

				end
			end
		end

		-- 📊 Cold Bar
		TweenService:Create(
			barFill,
			TweenInfo.new(
				0.1,
				Enum.EasingStyle.Linear
			),
			{
				Size = UDim2.new(
					math.max(
						progress,
						0.001
					),
					-6,
					1,
					-6
				)
			}
		):Play()

		-- ☠️ Cold đầy
		if currentFrost >= 100 then

			dmg = false
			humanoid.Health = 0

			pcall(function()

				local stats =
					ReplicatedStorage:
					FindFirstChild(
						"GameStats"
					)

				local statsFolder =
					stats
					and stats:FindFirstChild(
						"Player_" ..
						player.Name
					)

				if statsFolder
					and statsFolder:FindFirstChild(
						"Total"
					)
					and statsFolder.Total:
						FindFirstChild(
							"DeathCause"
						) then

					statsFolder.Total.DeathCause.Value =
						"Frostbite"
				end

			end)

			break
		end
	end
end)

