-- 📷 Camera Shake
local CameraShaker =
	ReplicatedStorage:FindFirstChild(
		"CameraShaker"
	)

if CameraShaker then

	local ok, module =
		pcall(require, CameraShaker)

	if ok and module then

		local camera =
			workspace.CurrentCamera

		local camShake =
			module.new(
				Enum.RenderPriority.Camera.Value,
				function(cf)
					camera.CFrame =
						camera.CFrame * cf
				end
			)

		camShake:Start()

		camShake:ShakeOnce(
			10,
			3,
			0.1,
			6,
			7,
			0.5
		)
	end
end

